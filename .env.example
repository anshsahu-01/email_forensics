MAXMIND_DB_PATH=/path/to/GeoLite2-City.mmdb

# Redis
REDIS_URL=

# Object Storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# AI Service
AI_SERVICE_URL=http://localhost:8000
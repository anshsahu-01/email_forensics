# Database
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=

# Backend
PORT=5000
NODE_ENV=development

# Authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Threat Intelligence
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# MaxMind GeoLite2-City database (local .mmdb file — never commit to version control)
